bb1_34:
  call void @sloth_rt_set_pc(ptr %vm, i64 34)
  %r_1_34 = call i32 @sloth_rt_exec(ptr %vm, i32 39, i64 0)
  switch i32 %r_1_34, label %bb1_err [
