  %b_1_33_tagged = or i1 %b_1_33_is7, %b_1_33_isf
  %b_1_33_num = xor i1 %b_1_33_tagged, true
  %both_1_33 = and i1 %a_1_33_num, %b_1_33_num
  br i1 %both_1_33, label %bb1_fast_33, label %bb1_slow_33

bb1_fast_33:
  %bv_1_33 = call i64 @sloth_rt_pop(ptr %vm)
  %av_1_33 = call i64 @sloth_rt_pop(ptr %vm)
  %ad_1_33 = bitcast i64 %av_1_33 to double
  %bd_1_33 = bitcast i64 %bv_1_33 to double
  %res_1_33 = fadd double %ad_1_33, %bd_1_33
  %resbits_1_33 = bitcast double %res_1_33 to i64
  call void @sloth_rt_push_number(ptr %vm, i64 %resbits_1_33)
  br label %bb1_after_33

bb1_slow_33:
  %r_1_33 = call i32 @sloth_rt_exec(ptr %vm, i32 14, i64 0)
  switch i32 %r_1_33, label %bb1_err [
    i32 0, label %bb1_after_33
    i32 1, label %bb1_changed
    i32 2, label %bb1_finished
  ]

bb1_after_33:
