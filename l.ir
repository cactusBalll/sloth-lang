bb1_35:
  call void @sloth_rt_set_pc(ptr %vm, i64 35)
  %r_1_35 = call i32 @sloth_rt_exec(ptr %vm, i32 39, i64 0)
  switch i32 %r_1_35, label %bb1_err [
    i32 0, label %bb1_after_35
    i32 1, label %bb1_changed
    i32 2, label %bb1_finished
  ]

bb1_after_35:
