// Sieve of Eratosthenes: array creation, indexing, nested loops.
var n = 500000;
var a = [];
var i = 0;
while (i < n) {
    a.push(1);
    i = i + 1;
}
a[0] = 0;
a[1] = 0;
i = 2;
while (i * i < n) {
    if (a[i] == 1) {
        var j = i * i;
        while (j < n) {
            a[j] = 0;
            j = j + i;
        }
    }
    i = i + 1;
}
var count = 0;
i = 0;
while (i < n) {
    count = count + a[i];
    i = i + 1;
}
print(count);
